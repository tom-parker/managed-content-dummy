{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["heading", "items"],
    "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 80 },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["id", "title", "description"],
                "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 180
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
